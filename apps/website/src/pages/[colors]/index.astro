---
/*
 * TEMPORARY: every colour of the theme on one page, with a tuner for settling the palette.
 * Served at /colors/ by `npm run dev` only; the build leaves it out. This folder holds all of it,
 * so removing the experiment is removing the folder.
 */
import Marketing from "../../layouts/Marketing.astro";
import DirectiveStrip from "../../components/DirectiveStrip.astro";
import Tuner from "./_Tuner.astro";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { colors: "colors" } }] : [];
}

const STEPS = ["95", "90", "80", "70", "60", "50", "40", "30", "20", "10", "05"];
const PALETTES = ["brand", "red", "orange", "yellow", "green", "cyan", "blue", "indigo", "purple", "pink", "gray"];
const VARIANTS = ["brand", "neutral", "success", "warning", "danger"];
const APPEARANCES = ["accent", "filled-outlined", "filled", "outlined", "plain"];
const CHART_HUES = ["red", "orange", "yellow", "green", "cyan", "blue", "indigo", "purple", "pink"];
const WHEEL = Array.from({ length: 36 }, (_, i) => i * 10);
const WHEEL_STEPS = ["80", "70", "60", "50", "40"];
const bars = [62, 48, 75, 33, 54, 41, 68, 29, 57];
---

<Marketing title="Colours · Cofy" description="Every colour of the Cofy theme.">
  <section class="section">
    <div class="wa-stack wa-gap-2xl colors">
      <h1 class="wa-heading-2xl">Colours</h1>

      <section class="wa-stack">
        <h2 class="wa-heading-l">Palettes</h2>
        <p class="wa-caption-m">
          Each hue on the shared ladder. Gray is Web Awesome's own; brand is its own hue (green by default).
        </p>
        <div class="palette">
          <span></span>
          {STEPS.map((step) => <span class="wa-caption-s">{step}</span>)}
          {
            PALETTES.map((name) => (
              <>
                <span class="wa-caption-m">{name}</span>
                {STEPS.map((step) => (
                  <span
                    class="step"
                    style={`background: var(--wa-color-${name}-${step}); color: ${Number(step) >= 70 ? "black" : "white"}`}
                  >
                    {step}
                  </span>
                ))}
              </>
            ))
          }
        </div>
      </section>

      <section class="wa-stack">
        <h2 class="wa-heading-l">Semantic tokens</h2>
        <p class="wa-caption-m">Fills with their "on" text colour, borders on the page, and "on-quiet" as text.</p>
        <div class="tokens">
          <span></span>
          {
            [
              "fill-quiet",
              "fill-normal",
              "fill-loud",
              "border-quiet",
              "border-normal",
              "border-loud",
              "on-quiet text",
            ].map((label) => <span class="wa-caption-s">{label}</span>)
          }
          {
            VARIANTS.map((v) => (
              <>
                <span class="wa-caption-m">{v}</span>
                {["quiet", "normal", "loud"].map((level) => (
                  <span
                    class="token"
                    style={`background: var(--wa-color-${v}-fill-${level}); color: var(--wa-color-${v}-on-${level})`}
                  >
                    Aa
                  </span>
                ))}
                {["quiet", "normal", "loud"].map((level) => (
                  <span class="token" style={`border-color: var(--wa-color-${v}-border-${level})`}>
                    Aa
                  </span>
                ))}
                <span class="token plain" style={`color: var(--wa-color-${v}-on-quiet)`}>
                  Aa
                </span>
              </>
            ))
          }
        </div>
      </section>

      <section class="wa-stack">
        <h2 class="wa-heading-l">Text</h2>
        <p>
          Normal text, <span class="wa-color-text-quiet">quiet text</span>, and <a href="#">a link</a> in a sentence.
        </p>
      </section>

      <section class="wa-stack">
        <h2 class="wa-heading-l">Buttons</h2>
        {
          VARIANTS.map((v) => (
            <div class="wa-cluster wa-gap-s">
              {APPEARANCES.map((appearance) => (
                <wa-button variant={v} appearance={appearance}>
                  {v} {appearance}
                </wa-button>
              ))}
            </div>
          ))
        }
      </section>

      <section class="wa-stack">
        <h2 class="wa-heading-l">Callouts</h2>
        <div class="wa-grid callouts">
          {
            VARIANTS.flatMap((v) =>
              ["filled-outlined", "accent"].map((appearance) => (
                <wa-callout variant={v} appearance={appearance}>
                  <strong>
                    {v} {appearance}
                  </strong>{" "}
                  - a message with <a href="#">a link</a>.
                </wa-callout>
              )),
            )
          }
        </div>
      </section>

      <section class="wa-stack">
        <h2 class="wa-heading-l">Badges and tags</h2>
        {
          ["accent", "filled-outlined", "outlined"].map((appearance) => (
            <div class="wa-cluster wa-gap-s">
              {VARIANTS.map((v) => (
                <wa-badge variant={v} appearance={appearance}>
                  {v}
                </wa-badge>
              ))}
              {VARIANTS.map((v) => (
                <wa-tag variant={v} appearance={appearance}>
                  {v}
                </wa-tag>
              ))}
            </div>
          ))
        }
      </section>

      <section class="wa-stack">
        <h2 class="wa-heading-l">Charts</h2>
        <p class="wa-caption-m">The nine hues as series, at steps 60 and 40.</p>
        {
          ["60", "40"].map((step) => (
            <div class="bars">
              {CHART_HUES.map((hue, i) => (
                <span title={`${hue}-${step}`} style={`block-size: ${bars[i]}%; background: var(--wa-color-${hue}-${step})`} />
              ))}
            </div>
          ))
        }
        <DirectiveStrip label="An example day of directives" caption="The directive colours" />
      </section>

      <section class="wa-stack">
        <h2 class="wa-heading-l">Hue wheel</h2>
        <p class="wa-caption-m">
          Every 10° on the ladder, for picking extra hues such as a second red. Hover a swatch for its hue.
        </p>
        <div class="wheel">
          {
            WHEEL_STEPS.map((step) =>
              WHEEL.map((hue) => (
                <span
                  title={`hue ${hue}, step ${step}`}
                  style={`background: oklch(var(--cofy-lightness-${step}) var(--cofy-chroma-${step}) ${hue})`}
                />
              )),
            )
          }
          {WHEEL.map((hue) => <span class="wa-caption-xs">{hue}</span>)}
        </div>
      </section>
    </div>
  </section>
  <Tuner />
</Marketing>

<style>
  .colors {
    padding-block-end: 20rem;
  }
  .palette,
  .tokens {
    display: grid;
    gap: var(--wa-space-2xs);
    align-items: center;
  }
  .palette {
    grid-template-columns: 5rem repeat(11, minmax(0, 1fr));
  }
  .tokens {
    grid-template-columns: 5rem repeat(7, minmax(0, 1fr));
  }
  .step,
  .token {
    display: grid;
    place-items: center;
    block-size: var(--wa-space-3xl);
    border-radius: var(--wa-border-radius-s);
    font-size: var(--wa-font-size-xs);
  }
  .token {
    font-size: var(--wa-font-size-m);
    font-weight: var(--wa-font-weight-semibold);
    border: var(--wa-border-width-m) solid transparent;
  }
  .callouts {
    --min-column-size: 20rem;
  }
  .bars {
    display: flex;
    align-items: end;
    gap: var(--wa-space-2xs);
    block-size: 8rem;
  }
  .bars span {
    flex: 1;
    border-radius: var(--wa-border-radius-s) var(--wa-border-radius-s) 0 0;
  }
  .wheel {
    display: grid;
    grid-template-columns: repeat(36, minmax(0, 1fr));
    gap: 2px;
  }
  .wheel span {
    block-size: var(--wa-space-xl);
  }
  .wheel .wa-caption-xs {
    block-size: auto;
    text-align: center;
    font-size: 0.6rem;
  }
</style>
