# Serves the built site on port 8080. HTTPS, and logging requests, are left to the proxy in front of it.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	# Astro names everything under _astro/ after its content, so a changed file is a new name: keep them for good.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
