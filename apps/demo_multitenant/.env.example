# A server's own settings, provided by hand as /opt/cofy/.env (root-owned, mode 600) - the deploy never writes it.

# Where this server is reached; Caddy gets its certificate for it, and the communities are under /communities.
COFY_DOMAIN=dev.cofy.cloud
# The `environment` label on its logs in Loki.
COFY_ENVIRONMENT=dev
# Which refs `cofy-deploy` deploys here, as a pattern: `refs/heads/main` on dev, `refs/tags/cloud-v*` on production.
COFY_DEPLOY_REFS=refs/heads/main

# The management API's login, at the identity provider; the redirect URI to register is https://<COFY_DOMAIN>/auth/callback.
COFY_MANAGEMENT_OIDC_ISSUER=
COFY_MANAGEMENT_OIDC_CLIENT_ID=
COFY_MANAGEMENT_OIDC_CLIENT_SECRET=
# A long random value the session cookie is signed with: `openssl rand -hex 32`.
COFY_MANAGEMENT_SESSION_SECRET=
# Optional: `openid profile email` and `PT8H` by default.
COFY_MANAGEMENT_OIDC_SCOPES=
COFY_MANAGEMENT_SESSION_LIFETIME=

# Where the logs go: Loki's push endpoint, such as https://loki.example.com/loki/api/v1/push, and its basic auth.
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
