# Every request, as JSON on stderr, for Loki (`config.alloy`): what was asked, how it was answered and how long it
# took. Not the headers, and not the `token` in a query, which is an API key.
(log_requests) {
	log {
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}
}

# A service that a deploy replaces without downtime (`docker-compose.yml`): while it does, the service's name resolves
# to both the old and the new container, one of which may not be listening yet, or anymore. A request that can't
# connect is tried again, for up to 10s, rather than answered with a 502.
(service) {
	reverse_proxy {args[0]} {
		lb_try_duration 10s
	}
}

{$COFY_DOMAIN} {
	import log_requests
	# The communities' APIs, each under /communities/<slug>/; the prefix is stripped, and the
	# runner told it through UVICORN_ROOT_PATH.
	handle_path /communities/* {
		import service runner:8080
	}
	# Everything else is the management API and its console.
	handle {
		import service app:8080
	}
}

# The public website, on a domain of its own.
{$COFY_WEBSITE_DOMAIN} {
	import log_requests
	import service website:8080
}
