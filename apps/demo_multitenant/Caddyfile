{$COFY_DOMAIN} {
	# The communities' APIs, each under /communities/<slug>/; the prefix is stripped, and the
	# runner told it through UVICORN_ROOT_PATH.
	handle_path /communities/* {
		reverse_proxy runner:8080
	}
	# Everything else is the management API and its console.
	handle {
		reverse_proxy app:8080
	}
}
