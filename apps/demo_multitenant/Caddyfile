# Every request, as JSON on stderr, for Loki (`config.alloy`): what was asked, how it was answered and how long it
# took. Not the headers, and not the `token` in a query, which is an API key.
(log_requests) {
	log {
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}
}

{$COFY_DOMAIN} {
	import log_requests
	# The communities' APIs, each under /communities/<slug>/; the prefix is stripped, and the
	# runner told it through UVICORN_ROOT_PATH.
	handle_path /communities/* {
		reverse_proxy runner:8080
	}
	# Everything else is the management API and its console.
	handle {
		reverse_proxy app:8080
	}
}

# The public website, on a domain of its own.
{$COFY_WEBSITE_DOMAIN} {
	import log_requests
	reverse_proxy website:8080
}
