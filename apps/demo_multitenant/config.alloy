// Ships the logs of this compose project's containers to Loki, labelled with the environment, the compose service and
// each record's level; and the metrics of the host, of those containers and of probing the public URLs to Prometheus,
// labelled with the environment.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"

  // Only Cofy's own containers (`name` in `docker-compose.yml`): whatever else runs on the server isn't ours to ship.
  filter {
    name   = "label"
    values = ["com.docker.compose.project=cofy"]
  }
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.containers.receiver]
}

// Every record starts with its time - the apps' (`logging.yaml`) as text, Caddy's as JSON, Alloy's own as logfmt - so a
// line that doesn't, such as a traceback's, continues the record before it.
loki.process "containers" {
  forward_to = [loki.write.default.receiver]

  stage.multiline {
    firstline     = `^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}|\{|ts=)`
    max_wait_time = "3s"
  }

  stage.regex {
    expression = `^\d{4}-\d{2}-\d{2} \S+ (?P<level>[A-Z]+) `
  }

  stage.regex {
    expression = `^\{"level":"(?P<level>\w+)"`
  }

  stage.regex {
    expression = `^ts=\S+ level=(?P<level>\w+)`
  }

  // An exception nothing handles is printed as a bare traceback, and stops the process. Its lines can't be told from
  // those of a logged exception's traceback, so they stay apart, the first one marked as the error.
  stage.regex {
    expression = `^(?P<traceback>Traceback) `
  }

  stage.template {
    source   = "level"
    template = `{{ if .traceback }}error{{ else }}{{ ToLower .Value }}{{ end }}`
  }

  stage.labels {
    values = { level = "" }
  }
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL")

    basic_auth {
      username = sys.env("LOKI_USERNAME")
      password = sys.env("LOKI_PASSWORD")
    }
  }

  external_labels = {
    app         = "cofy",
    environment = sys.env("COFY_ENVIRONMENT"),
  }
}

// The host's CPU, memory, disks and load, read from its /proc, /sys and / (`docker-compose.yml`).
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
}

prometheus.scrape "host" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.relabel.server.receiver]
}

// The CPU, memory and start time of each of the compose services' processes, read from the host's /proc, and named
// after their service.
prometheus.exporter.process "services" {
  procfs_path = "/host/proc"

  matcher {
    name    = "app"
    cmdline = [`cofy\.management\.main:app`]
  }

  matcher {
    name    = "runner"
    cmdline = [`cofy\.runner\.main:app`]
  }

  // The website's own Caddy, told apart from the one in front by its config file; matched first, as both are `caddy`.
  matcher {
    name    = "website"
    cmdline = [`website\.Caddyfile`]
  }

  matcher {
    name = "caddy"
    comm = ["caddy"]
  }

  matcher {
    name = "alloy"
    comm = ["alloy"]
  }
}

prometheus.scrape "services" {
  targets    = prometheus.exporter.process.services.targets
  forward_to = [prometheus.relabel.server.receiver]
}

// Whether the console, the communities' APIs and the website answer at their public URLs, through DNS, TLS and Caddy
// as anyone would reach them. The runner has no route of its own, so its 404 is how it answers at /communities/ - Caddy answers 502
// when it doesn't.
prometheus.exporter.blackbox "checks" {
  config = `{
    modules: {
      console: { prober: http, timeout: 10s },
      communities: { prober: http, timeout: 10s, http: { valid_status_codes: [404] } },
      website: { prober: http, timeout: 10s },
    },
  }`

  target {
    name    = "console"
    address = "https://" + sys.env("COFY_DOMAIN") + "/"
    module  = "console"
  }

  target {
    name    = "communities"
    address = "https://" + sys.env("COFY_DOMAIN") + "/communities/"
    module  = "communities"
  }

  target {
    name    = "website"
    address = "https://" + sys.env("COFY_WEBSITE_DOMAIN") + "/"
    module  = "website"
  }
}

prometheus.scrape "checks" {
  targets    = prometheus.exporter.blackbox.checks.targets
  forward_to = [prometheus.relabel.server.receiver]
}

// Every metric's `instance` is the server's domain, rather than Alloy's container, which is another with every deploy.
prometheus.relabel "server" {
  forward_to = [prometheus.remote_write.default.receiver]

  rule {
    target_label = "instance"
    replacement  = sys.env("COFY_DOMAIN")
  }
}

prometheus.remote_write "default" {
  endpoint {
    url = sys.env("PROMETHEUS_URL")

    basic_auth {
      username = sys.env("PROMETHEUS_USERNAME")
      password = sys.env("PROMETHEUS_PASSWORD")
    }
  }

  external_labels = {
    app         = "cofy",
    environment = sys.env("COFY_ENVIRONMENT"),
  }
}
